# Environment template — copy to .env.local and fill in.
#
# .env.local is git-ignored and must never be committed. Every value below is a
# PLACEHOLDER. If you ever paste a real key into THIS file, it will be published
# to a public repository — put real values in .env.local only.

# --- Where the live listing catalogue and advisor chat are served -------------
# Public endpoint the browser calls. Not a secret.
VITE_LH_CONCIERGE_URL="https://YOUR-PROJECT.function2.insforge.app/lh-concierge"

# --- Lead delivery (edge function runtime only, never bundled to the browser) --
# Server-side only. Set these as secrets on the function, not in the frontend.
INSFORGE_BASE_URL="https://YOUR-PROJECT.us-east.insforge.app"
ANON_KEY="SERVER_SIDE_KEY_GOES_HERE"
OPENROUTER_API_KEY="SERVER_SIDE_KEY_GOES_HERE"
OPENROUTER_CHAT_MODEL="SERVER_SIDE_KEY_GOES_HERE"

# --- Booking notifications ----------------------------------------------------
# Where inspection requests are delivered.
LEADS_INBOX="leads@yourdomain.com"
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT="587"
SMTP_USER="SERVER_SIDE_VALUE_GOES_HERE"
SMTP_PASS="SERVER_SIDE_VALUE_GOES_HERE"
EMAIL_FROM="bookings@yourdomain.com"

# --- Public site address ------------------------------------------------------
# Used for self-referential links in emails and confirmations.
APP_URL="https://your-site.example.com"